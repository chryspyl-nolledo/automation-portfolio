    {
      "parameters": {
        "jsCode": "const DAY = 864e5;\nconst now = new Date();\nconst today = new Date(now.getFullYear(), now.getMonth(), now.getDate());\nconst parse = s => {\n  const [d, t = '00:00'] = String(s).trim().split(' ');\n  const [y, m, dd] = d.split('-').map(Number);\n  const [h, mi] = t.split(':').map(Number);\n  return new Date(y, m - 1, dd, h, mi);\n};\nconst days = (a, b) => Math.round((b - a) / DAY);\nconst usd = n => 'USD ' + Math.round(n).toLocaleString('en-US');\n\n// RightShip: open and overdue or due within 7 days\nconst rs = $('Read RightShip').all().map(i => i.json)\n  .filter(r => String(r.Status).trim() !== 'Closed')\n  .map(r => ({ ...r, left: days(today, parse(r['Due Date'])) }))\n  .filter(r => r.left <= 7)\n  .sort((a, b) => a.left - b.left)\n  .map(r => `- ${r.Vessel} ${r.Ref}: ${r.Observation} – ` +\n    (r.left < 0 ? `OVERDUE by ${-r.left} day${r.left === -1 ? '' : 's'}` : r.left === 0 ? 'due today' : `due in ${r.left} day${r.left === 1 ? '' : 's'}`) +\n    ` (${r['Due Date']})`);\n\n// Hull: 150+ days since cleaning, or 20+ idle days\nconst hull = $('Read Hull').all().map(i => i.json)\n  .map(h => ({ ...h, since: days(parse(h['Last Hull Cleaning']), today), idle: Number(h['Idle Days 30d']) || 0 }))\n  .filter(h => h.since >= 150 || h.idle >= 20)\n  .map(h => `- ${h.Vessel}: ${h.since} days since hull cleaning` +\n    (h.since >= 180 ? ' (OVERDUE)' : h.since >= 150 ? ' (due soon)' : '') +\n    (h.idle >= 20 ? `; ${h.idle} idle days in the last 30 – check fouling` : ''));\n\n// Off-hire: events with no End date are still open\nconst oh = $('Read Offhire').all().map(i => i.json)\n  .filter(o => !String(o.End || '').trim())\n  .map(o => {\n    const d = (now - parse(o.Start)) / DAY;\n    return `- ${o.Vessel}: ${o.Reason} – off-hire since ${o.Start} (${d.toFixed(1)} days, about ${usd(d * Number(o['Hire Rate']))} hire lost)`;\n  });\n\nconst count = rs.length + hull.length + oh.length;\nconst dateStr = today.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });\nconst section = (title, list) => `${title} (${list.length})\\n${list.length ? list.join('\\n') : '- None'}`;\n\nconst body = [\n  'Good morning,',\n  '',\n  `Fleet Ops daily alert for ${dateStr}:`,\n  '',\n  section('RIGHTSHIP OBSERVATIONS', rs),\n  '',\n  section('HULL CLEANING', hull),\n  '',\n  section('OFF-HIRE', oh),\n  '',\n  'Open the tracker: https://d123alnn5vo5uv.cloudfront.net/fleet-ops-app.html',\n  '',\n  '– Fleet Ops Tracker (automated by n8n)'\n].join('\\n');\n\nconst subject = `Fleet Ops daily alert – ${dateStr}: ${rs.length} RightShip, ${hull.length} hull, ${oh.length} off-hire`;\n\nreturn [{ json: { count, subject, body } }];"
      },
