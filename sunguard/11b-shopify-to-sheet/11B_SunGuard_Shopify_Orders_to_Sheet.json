    {
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-STORE.myshopify.com/admin/api/2026-10/graphql.json",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "shopifyOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"query\": \"{ orders(first: 20, reverse: true) { edges { node { name createdAt displayFinancialStatus displayFulfillmentStatus lineItems(first: 20) { edges { node { title sku quantity originalUnitPriceSet { shopMoney { amount } } } } } } } } }\"}",
        "options": {}
      },
      "id": "31bbd015-2486-4fd5-83e8-e491ec509639",
      "name": "Get Shopify orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        100
      ],
      "executeOnce": true,
      "credentials": {
        "shopifyOAuth2Api": {
          "id": "CREDENTIAL_ID",
          "name": "Shopify account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Turn each Shopify order line into one Orders-tab row, and skip rows already in the sheet\nconst existing = new Set($('Get existing orders').all().map(i => String(i.json.Order_ID || '')));\nconst edges = $('Get Shopify orders').first().json.data?.orders?.edges || [];\nconst out = [];\nfor (const e of edges) {\n  const o = e.node;\n  for (const le of (o.lineItems?.edges || [])) {\n    const li = le.node;\n    const id = `SHOPIFY-${o.name.replace('#','')}-${li.sku || 'NOSKU'}`;\n    if (existing.has(id)) continue;\n    const unit = Number(li.originalUnitPriceSet?.shopMoney?.amount || 0);\n    out.push({ json: {\n      Order_ID: id,\n      Order_Date: o.createdAt.replace('T',' ').slice(0,19),\n      Customer_Name: 'Shopify customer',\n      Customer_Email: '',\n      Customer_Phone: '',\n      Product_ID: li.sku || '',\n      Product_Name: li.title,\n      Quantity: li.quantity,\n      Unit_Price_PHP: unit,\n      Total_PHP: unit * li.quantity,\n      Order_Status: `Shopify - ${o.displayFinancialStatus}`,\n      Stock_Deducted: 'By Shopify',\n      Notification_Status: 'Sent',\n      Shopify_Order: o.name\n    }});\n  }\n}\nreturn out;"
      },
