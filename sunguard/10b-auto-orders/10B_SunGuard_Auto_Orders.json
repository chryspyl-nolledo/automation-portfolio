    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.Order_ID);\nif(rows.length!==1)throw new Error('Expected one matching order; got '+rows.length);\nconst o=rows[0];\nconst status=String(o.Order_Status??'').trim();\nif(!['New','Demo - Confirmed'].includes(status))throw new Error('Order status not eligible: '+status);\nif(String(o.Stock_Deducted??'').trim().toLowerCase()!=='no')throw new Error('Order already deducted or flag is not No');\nconst qty=Number(o.Quantity);\nif(!Number.isSafeInteger(qty)||qty<1||qty>20)throw new Error('Quantity outside 1–20');\nif(!String(o.Product_ID??'').trim())throw new Error('Missing Product_ID');\nreturn [{json:{order_id:String(o.Order_ID),product_id:String(o.Product_ID),quantity:qty,dry_run:$('CONFIG - DRY RUN TRUE').first().json.dry_run}}];"
      },
      "id": "2ea11349-2e30-4fa8-9f13-3440aa70fe41",
      "name": "Validate Order",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
