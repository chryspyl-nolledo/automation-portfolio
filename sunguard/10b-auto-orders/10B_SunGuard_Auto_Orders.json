      "parameters": {
        "jsCode": "// SAFE IMPORT: Keep dry_run:true until the full scheduled branch is reviewed.\n// On the scheduled branch the ID comes from the New order; manual test keeps an example ID.\nconst incoming = $input.first().json || {};\nconst order_id = String(incoming.Order_ID || incoming.order_id || 'DEMO-20261105130312').trim();\nif (!order_id) throw new Error('Missing Order ID');\nreturn [{json:{order_id,dry_run:false}}];"
      },
