    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.Order_ID);\nif(rows.length!==1)throw new Error('Expected exactly one matching Order_ID; found '+rows.length);\nconst o=rows[0];\nif(String(o.Order_Status??'').trim()!=='Demo - Confirmed')throw new Error('Order is not Demo - Confirmed');\nif(String(o.Stock_Deducted??'').trim().toLowerCase()!=='no')throw new Error('Stock already deducted or field not No');\nconst qty=Number(o.Quantity);\nif(!Number.isSafeInteger(qty)||qty<1)throw new Error('Invalid order quantity');\nif(!String(o.Product_ID??'').trim())throw new Error('Missing product ID');\nreturn [{json:{order_id:String(o.Order_ID),product_id:String(o.Product_ID),quantity:qty,dry_run:$('CONFIG - DRY RUN TRUE').first().json.dry_run}}];"
      },
