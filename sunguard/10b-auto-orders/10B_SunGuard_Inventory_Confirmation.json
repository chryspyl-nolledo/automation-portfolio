    {
      "parameters": {
        "jsCode": "const rows=$input.all().map(x=>x.json).filter(x=>x.Product_ID);\nif(rows.length!==1)throw new Error('Expected exactly one matching Product_ID; found '+rows.length);\nconst p=rows[0]; const order=$('Validate Order').first().json;\nconst stock=Number(p.Stock_Qty), threshold=Number(p.Low_Stock_Threshold),qty=order.quantity;\nif(!Number.isFinite(stock)||stock<0||!Number.isFinite(threshold)||threshold<0)throw new Error('Invalid stock or threshold');\nif(stock<qty)throw new Error('Not enough stock: '+stock+' available, '+qty+' ordered');\nif(String(p.Status??'').trim()!=='Active')throw new Error('Product not active');\nconst remaining=stock-qty;\nreturn [{json:{order_id:order.order_id,product_id:order.product_id,product_name:String(p.Product_Name??''),quantity:qty,old_stock:stock,new_stock:remaining,threshold,low_stock:remaining<=threshold,dry_run:order.dry_run}}];"
      },
